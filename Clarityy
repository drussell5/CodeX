        "    return [\"LendingTree\", \"Sofi\", \"Marcus by Goldman Sachs\"]\n",
        "  elif score >= 640:\n",
        "    return [\"Upstart\", \"Avant\", \"OneMain Financial\"]\n",
        "  else:\n",
        "    return [\"OppLoans\", \"NetCredit\"]\n",
        "\n",
        "# --- Perform Calculations (from ipython-input-13-) ---\n",
        "# Note: You need to determine what 'debt' should be for the DTI calculation.\n",
        "# Based on typical DTI, it should be total monthly debt payments.\n",
        "# The current code only uses monthly_expenses and loan_amount.\n",
        "# Assuming 'debt' for DTI is monthly_expenses for this example, adjust if needed.\n",
        "dti = calculate_dti(monthly_expenses + (loan_amount/12), income) # A more typical DTI uses estimated monthly loan payment\n",
        "apr = estimate_apr(credit_score)\n",
        "approval = approval_likelihood(credit_score, dti)\n",
        "matching_brokers = broker_match(credit_score, dti)\n",
        "\n",

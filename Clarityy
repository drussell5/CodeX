ocument.getElementById('question').value; const res = await fetch('/ask', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ question }) }); const data = await res.json(); document.getElementById('assistant-answer').innerText = data.answer; }; // Add Dispute document.getElementById('disputeForm').onsubmit = async function(e) { e.preventDefault(); const creditor = document.getElementById('creditor').value; const account = document.getElementById('account').value; const reason = document.getElementById('reason').value; await fetch('/add_dispute', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ creditor, account, reason }) }); loadDisputes(); }; // Load and render disputes async function loadDisputes() { const res = await fetch('/get_disputes'); const disputes = await res.json(); const container = document.getElementById('disputeList'); container.innerHTML = ''; disputes.forEach(d => { const div = document.createElement('div'); div.className = 'dispute'; div.innerHTML = ` <h4><strong>Creditor:</strong> ${d.creditor}</h4> <p><strong>Account:</strong> ${d.account}</p> <p><strong>Reason:</strong> ${d.reason}</p> <p><strong>Status:</strong> ${d.status}</p> <div class=\"status\"> <label>Update Status:</label> <select onchange=\"updateStatus(${d.id}, this.value)\"> <option value=\"\">-- Choose --</option> <option value=\"Pending\">Pending</option> <option value=\"Sent\">Sent</option> <option value=\"Resolved\">Resolved</option> </select> </div> <a href=\"/export_pdf/${d.id}\" target=\"_blank\"><button>Download Letter</button></a> `; container.appendChild(div); }); } // Update dispute status async function updateStatus(id, status) { await fetch('/update_dispute', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, status }) }); loadDisputes(); } // Initial load loadDisputes(); </script> </body> </html>"
